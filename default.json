{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate defaults",
  "extends": ["config:best-practices", "schedule:weekly", "helpers:pinGitHubActionDigestsToSemver"],
  "timezone": "America/Los_Angeles",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Enforce minimum release age for GitHub Actions",
      "matchManagers": ["github-actions"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group and automerge all non-major updates",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "Group non-major devDependencies into their own group",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "non-major dev dependencies"
    },
    {
      "description": "Group GitHub Actions updates separately",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "github actions"
    },
    {
      "description": "0.x minors are breaking by convention - treat them like majors: individual PRs, manual review",
      "matchCurrentVersion": "/^0/",
      "matchUpdateTypes": ["minor"],
      "groupName": null,
      "automerge": false
    }
  ]
}
