{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate defaults",
  "extends": ["config:best-practices", "helpers:pinGitHubActionDigestsToSemver"],
  "timezone": "America/Los_Angeles",
  "labels": ["dependencies"],
  "schedule": ["* 0-8 * * 1"],
  "prHourlyLimit": 0,
  "lockFileMaintenance": {
    "schedule": ["* 0-8 * * 1"],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Enforce minimum release age for GitHub Actions",
      "matchManagers": ["github-actions"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group and automerge all non-major updates",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "dependencies",
      "automerge": true
    },
    {
      "description": "Group GitHub Actions updates separately",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "github actions"
    },
    {
      "description": "0.x minors are breaking by convention - treat them like majors: individual PRs, manual review",
      "matchCurrentVersion": "/^0/",
      "matchUpdateTypes": ["minor"],
      "groupName": null,
      "automerge": false
    },
    {
      "description": "0.0.x patches are breaking by convention too - a caret range on 0.0.x pins it exactly",
      "matchCurrentVersion": "/^0\\.0\\./",
      "matchUpdateTypes": ["patch"],
      "groupName": null,
      "automerge": false
    }
  ]
}
